{
  "name": "revenue-desk",
  "version": "0.0.0",
  "private": true,
  "description": "Revenue Desk: a back-office revenue-operations agent built on the Claude Agent SDK.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:(server|web)$/\"",
    "dev:server": "tsx watch --clear-screen=false src/server/main.ts",
    "dev:web": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && vite build && tsc -p tsconfig.server.json && node -e \"require('node:fs').chmodSync('dist/cli/main.js',0o755)\"",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config test/live/vitest.config.ts",
    "test:live:writes": "vitest run --config test/live/writes/vitest.config.ts",
    "test:live:ui": "node -e \"if(process.env.LIVE_E2E!=='1'){console.error('pnpm test:live:ui calls the real model and reads the connected Gmail inbox. Set LIVE_E2E=1 to run it.');process.exit(2)}\" && LIVE_UI=1 playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:cli && pnpm test:e2e",
    "cli": "node --import tsx src/cli/main.ts",
    "demo:firedrill": "node scripts/firedrill-demo.mjs",
    "demo:firedrill:test": "node scripts/firedrill-demo-test.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.121",
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@anthropic-ai/sdk": "0.128.0",
    "@composio/core": "0.21.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hono/node-server": "2.1.1",
    "@hubspot/mcp-server": "0.4.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "ai": "7.0.118",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.10",
    "lucide-react": "1.48.0",
    "nanoid": "6.0.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.4.3",
    "streamdown": "2.6.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@firedrill-run/cloud": "0.1.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "packageExtensions": {
      "@hubspot/mcp-server@0.4.0": {
        "dependencies": {
          "zod-to-json-schema": "3.25.2"
        }
      }
    }
  },
  "bin": {
    "revenue-desk": "dist/cli/main.js"
  }
}
