# Revenue Desk configuration template. Copy it outside the repository
# (README › Setup) and fill in the copy; never put values in this file itself
# or anywhere in the repository. DOTENV_PATH names the copy.
# The contract is src/contracts/env.ts (docs/ARCHITECTURE.md §3); a unit test
# keeps this file equal to it. There are no endpoint variables: Composio,
# HubSpot and Stripe are always reached at their own hosts.

# --- Model -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Default claude-sonnet-5. No silent model fallback.
AGENT_MODEL=
# low, medium, high, xhigh or max. Default medium.
AGENT_EFFORT=
# summarized or omitted. Default summarized in the UI, omitted in the CLI.
AGENT_THINKING_DISPLAY=
# Default 30.
AGENT_MAX_TURNS=
# Default 2.00 per run.
AGENT_MAX_BUDGET_USD=

# --- Runtime -----------------------------------------------------------------
# API server port (always bound to 127.0.0.1). Default 4320.
PORT=
# Default ./data (git-ignored). The server and the CLI share it.
AGENT_STATE_DIR=
# JSON approval modes per action class, e.g. {"financial":"deny"}; locks them.
AGENT_POLICY=
# Default 900000 (15 minutes).
AGENT_APPROVAL_TIMEOUT_MS=
# Optional path of an env file (outside the repository) to load at start.
DOTENV_PATH=

# --- Gmail, Google Calendar, QuickBooks and Slack (Composio) -----------------
# Each of the four is connected to this Composio user from Connections.
COMPOSIO_API_KEY=
# Required for all four; there is no default in code.
COMPOSIO_USER_ID=

# --- HubSpot (MCP) -----------------------------------------------------------
# HubSpot's official @hubspot/mcp-server 0.4.x runs over stdio with this token.
HUBSPOT_ACCESS_TOKEN=

# --- Stripe (API) ------------------------------------------------------------
# sk_test_/rk_test_ only; live keys are refused unless ALLOW_LIVE_STRIPE=1.
STRIPE_SECRET_KEY=
ALLOW_LIVE_STRIPE=
STRIPE_API_VERSION=

