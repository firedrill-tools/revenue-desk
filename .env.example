# Revenue Desk configuration: variable NAMES only. Never put real values in
# this file or anywhere in the repository. To use real keys, keep them in a
# file outside the repository and point DOTENV_PATH at it.
# See docs/ARCHITECTURE.md §3 for the full contract.

# --- Model -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Tests only (scripted Messages API).
ANTHROPIC_BASE_URL=
# Default claude-sonnet-5. No silent model fallback.
AGENT_MODEL=
# Default medium.
AGENT_EFFORT=
# summarized (UI) or omitted (headless).
AGENT_THINKING_DISPLAY=
AGENT_MAX_TURNS=
AGENT_MAX_BUDGET_USD=

# --- Runtime -----------------------------------------------------------------
# API server port (bound to 127.0.0.1). Default 4320.
PORT=
# Default ./data (git-ignored).
AGENT_STATE_DIR=
# JSON overriding approval modes per action class.
AGENT_POLICY=
# ISO date; defaults to today.
AGENT_BUSINESS_DATE=
AGENT_APPROVAL_TIMEOUT_MS=
# Optional path of an env file (outside the repository) to load at start.
DOTENV_PATH=

# --- Composio: Gmail and Google Calendar --------------------------------------
COMPOSIO_API_KEY=
# Required when Composio is used; there is no default in code.
COMPOSIO_USER_ID=

# Direct MCP overrides (bypass Composio for that integration).
GMAIL_MCP_URL=
GMAIL_MCP_TOKEN=
# google (default) or composio.
GMAIL_MCP_PROFILE=
GOOGLE_CALENDAR_MCP_URL=
GOOGLE_CALENDAR_MCP_TOKEN=
GOOGLE_CALENDAR_MCP_PROFILE=

# --- MCP: HubSpot ------------------------------------------------------------
# HTTP MCP (any server) when the URL is set; otherwise @hubspot/mcp-server over stdio.
HUBSPOT_MCP_URL=
HUBSPOT_MCP_TOKEN=
# stdio: passed to the child as PRIVATE_APP_ACCESS_TOKEN.
HUBSPOT_ACCESS_TOKEN=
# Tests only: override the stdio command and its JSON-array arguments.
HUBSPOT_MCP_COMMAND=
HUBSPOT_MCP_ARGS=

# --- API: Stripe -------------------------------------------------------------
# sk_test_/rk_test_ only; live keys are refused unless ALLOW_LIVE_STRIPE=1.
STRIPE_SECRET_KEY=
ALLOW_LIVE_STRIPE=
# Default https://api.stripe.com (may include a path prefix).
STRIPE_API_BASE_URL=
# Optional extra header name that also receives "Bearer <token>".
STRIPE_API_PROXY_AUTH_HEADER=
STRIPE_API_VERSION=

# --- API: QuickBooks Online --------------------------------------------------
QBO_ACCESS_TOKEN=
QBO_REALM_ID=
# Default https://sandbox-quickbooks.api.intuit.com
QBO_API_BASE_URL=
QBO_API_PROXY_AUTH_HEADER=
QBO_MINOR_VERSION=

# --- API: Slack --------------------------------------------------------------
SLACK_BOT_TOKEN=
# Default https://slack.com
SLACK_API_BASE_URL=
SLACK_API_PROXY_AUTH_HEADER=
